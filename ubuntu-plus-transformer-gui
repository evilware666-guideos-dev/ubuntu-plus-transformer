            )
        )
        dialog.add_button("❌ Abbrechen", Gtk.ResponseType.CANCEL)
        apply_btn = dialog.add_button("✅ Ja, ich bin mir sicher – jetzt anwenden!", Gtk.ResponseType.OK)
        apply_btn.add_css_class("destructive-action")

        dialog.connect("response", self.on_apply_confirmed)
        dialog.present()

    def on_apply_confirmed(self, dialog, response):
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.icon_whitesur = self.icon_whitesur_chk.get_active()
            self.icon_minty = self.icon_minty_chk.get_active()
            self.icon_we10x = self.icon_we10x_chk.get_active()
            self.icon_breeze = self.icon_breeze_chk.get_active()
            self.icon_zorin = self.icon_zorin_chk.get_active()
            self.icon_moka = self.icon_moka_chk.get_active()
            self.icon_numix = self.icon_numix_chk.get_active()
            self.icon_pop = self.icon_pop_chk.get_active()
            self.icon_papirus = self.icon_papirus_chk.get_active()

            self.office_suite = self.get_selected_office_suite()

            self.install_brave   = self.brave_check.get_active()   and not self.brave_installed
            self.remove_brave    = self.brave_check.get_active()   and self.brave_installed
            self.install_vivaldi = self.vivaldi_check.get_active() and not self.vivaldi_installed
            self.remove_vivaldi  = self.vivaldi_check.get_active() and self.vivaldi_installed
            self.install_chrome  = self.chrome_check.get_active()  and not self.chrome_installed
            self.remove_chrome   = self.chrome_check.get_active()  and self.chrome_installed
            self.install_firefox = self.firefox_check.get_active() and not self.firefox_installed
            self.remove_firefox  = self.firefox_check.get_active() and self.firefox_installed

            self.wallpaper_enabled = self.wallpaper_enabled_check.get_active()

            if self.radio_whitesur.get_active():
                self.default_icon = "whitesur"
            elif self.radio_minty.get_active():
                self.default_icon = "minty"
            elif self.radio_we10x.get_active():
                self.default_icon = "we10x"
            elif self.radio_breeze.get_active():
                self.default_icon = "breeze"
            elif self.radio_zorin.get_active():
                self.default_icon = "zorin"
            elif self.radio_moka.get_active():
                self.default_icon = "moka"
            elif self.radio_numix.get_active():
                self.default_icon = "numix"
            elif self.radio_pop.get_active():
                self.default_icon = "pop"
            elif self.radio_papirus.get_active():
                self.default_icon = "papirus"
            elif self.radio_yaru.get_active():
                self.default_icon = "yaru"

            self.current_page = 8
            self.page_stack.set_visible_child_name("install")

            GLib.idle_add(self.start_pulse)

            self.log_toggle_button.set_active(False)
            self.log_revealer.set_reveal_child(False)
            self.log_toggle_button.set_label("📄 Log-Fenster anzeigen")

            threading.Thread(target=self.run_transformer, daemon=True).start()

    # ─────────────────────────────────────────────────────────
    # Backend-Aufruf
    # ─────────────────────────────────────────────────────────
    def _build_backend_args(self):
        args = []

        # ── Gaming ──
        if self.games_enabled:
            args += [
                "--install-steam",
                "--install-lutris",
                "--install-heroic",
                "--install-protonup",
                "--install-protontricks",
                "--install-faugus",
                "--install-mangohud",
                "--install-goverlay",
                "--install-gamemode",
            ]
        else:
            args.append("--no-games")

        # ── Office ──
        if self.office_suite == "none":
            args.append("--no-office")
        else:
            args.append(f"--office={self.office_suite}")

        # ── Browser installieren ──
        if self.install_brave:
            args.append("--install-brave")
        if self.install_vivaldi:
            args.append("--install-vivaldi")
        if self.install_chrome:
            args.append("--install-chrome")
        if self.install_firefox:
            args.append("--install-firefox")

        # ── Browser entfernen ──
        if self.remove_brave:
            args.append("--remove-brave")
        if self.remove_vivaldi:
            args.append("--remove-vivaldi")
        if self.remove_chrome:
            args.append("--remove-chrome")
        if self.remove_firefox:
            args.append("--remove-firefox")

        # ── Wallpaper ──
        if self.wallpaper_enabled and self.selected_wallpaper:
            wp_abs = os.path.abspath(os.path.expanduser(self.selected_wallpaper))
            args.append(f"--wallpaper={wp_abs}")

        # ── Firewall ──
        if not self.firewall_enabled:
            args.append("--no-firewall")

        # ── Icon-Themes installieren ──
        if self.icon_whitesur:
            args.append("--install-whitesur")
        if self.icon_minty:
            args.append("--install-minty")
        if self.icon_we10x:
            args.append("--install-we10x")
        if self.icon_breeze:
            args.append("--install-breeze")
        if self.icon_zorin:
            args.append("--install-zorin")
        if self.icon_moka:
            args.append("--install-moka")
        if self.icon_numix:
            args.append("--install-numix")
        if self.icon_pop:
            args.append("--install-pop")
        if self.icon_papirus:
            args.append("--install-papirus")

        args.append(f"--default-icon={self.default_icon}")

        return args

    def run_transformer(self):
        args = self._build_backend_args()

        script_path = None
        possible_paths = [
            "/usr/bin/ubuntu-plus-transformer",
            "/usr/bin/ubuntu-transformer",
            "/usr/local/bin/ubuntu-plus-transformer",
            "/usr/local/bin/ubuntu-transformer",
            os.path.join(SCRIPT_DIR, "ubuntu-plus-transformer"),
            os.path.join(SCRIPT_DIR, "ubuntu-plus-transformer.sh"),
            os.path.join(SCRIPT_DIR, "..", "bin", "ubuntu-plus-transformer"),
        ]
        for path in possible_paths:
            if os.path.isfile(path) and os.access(path, os.X_OK):
                script_path = path
                break

        if script_path is None:
            GLib.idle_add(self.set_install_status, "❌ Transformer-Skript nicht gefunden.")
            GLib.idle_add(self.append_output,
                          "❌ Backend-Skript nicht gefunden. Bitte eines der\n"
                          "   folgenden Pfade prüfen oder das Paket neu installieren:\n"
                          + "\n".join(f"   • {p}" for p in possible_paths) + "\n")
            GLib.idle_add(self.stop_pulse, False)
            return

        GLib.idle_add(self.append_output, f"ℹ️  Verwende Skript: {script_path}\n")
        GLib.idle_add(self.append_output, f"ℹ️  Argumente: {' '.join(args)}\n")

        pkexec_path = self.find_pkexec()
        if not pkexec_path:
            GLib.idle_add(self.set_install_status, "❌ pkexec nicht gefunden – bitte manuell ausführen.")
            GLib.idle_add(self.stop_pulse, False)
            return

        # ─────────────────────────────────────────────────────
        # EINFACHER pkexec-Aufruf (kein env-Wrapper).
        # pkexec setzt automatisch PKEXEC_UID – das CLI-Skript
        # erkennt den echten Benutzer dadurch zuverlässig.
        # ─────────────────────────────────────────────────────
        cmd = [pkexec_path, script_path] + args

        # Info-Ausgabe (nur Log)
        real_user = get_real_username()
        GLib.idle_add(self.append_output,
                      f"ℹ️  Aufrufender Benutzer (Info): {real_user or 'unbekannt'}\n")

        try:
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in iter(process.stdout.readline, ''):
                GLib.idle_add(self.append_output, line)
            process.wait()
            if process.returncode == 0:
                GLib.idle_add(self.set_install_status, "✅ Installation erfolgreich! Neustart empfohlen.")
                GLib.idle_add(self.stop_pulse, True)
                self.installation_done = True
                GLib.idle_add(self.show_success_dialog)
            else:
                GLib.idle_add(self.set_install_status, f"❌ Fehler (Code {process.returncode})")
                GLib.idle_add(self.stop_pulse, False)
        except Exception as e:
            GLib.idle_add(self.set_install_status, f"❌ Fehler: {str(e)}")
            GLib.idle_add(self.stop_pulse, False)

    def find_pkexec(self):
        for path in os.environ.get("PATH", "").split(":"):
            candidate = os.path.join(path, "pkexec")
            if os.path.exists(candidate) and os.access(candidate, os.X_OK):
                return candidate
        return None

    def append_output(self, text):
        end_iter = self.output_buffer.get_end_iter()
        self.output_buffer.insert(end_iter, text)
        self.output_view.scroll_to_iter(self.output_buffer.get_end_iter(), 0.0, True, 0.0, 0.0)

    def set_install_status(self, message):
        self.install_status.set_text(message)

    def show_message_dialog(self, title, text, is_error=False):
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            modal=True,
            text=title,
            secondary_text=text
        )
        btn = dialog.add_button("OK", Gtk.ResponseType.OK)
        if is_error:
            btn.add_css_class("destructive-action")
        else:
            btn.add_css_class("suggested-action")
        dialog.connect("response", lambda d, r: d.destroy())
        dialog.present()


def main():
    app = UbuntuTransformerWizard()
    app.run(sys.argv)

if __name__ == "__main__":
    main()
