    def _create_flowbox(self):
        flowbox = Gtk.FlowBox()
        flowbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        flowbox.set_max_children_per_line(4)
        flowbox.set_min_children_per_line(3)
