        flowbox.set_valign(Gtk.Align.START)
        flowbox.set_activate_on_single_click(False)
        flowbox.connect("child-activated", self._on_wallpaper_thumb_activated)
        flowbox.connect(
            "selected-children-changed",
            lambda fb: self._on_wallpaper_thumb_selected(fb)
        )
        return flowbox

    def _add_wallpaper_thumb(self, flowbox, path):
        try:
            picture = Gtk.Picture.new_for_filename(path)
            if picture is None:
                return
            picture.set_content_fit(Gtk.ContentFit.COVER)
            picture.set_size_request(150, 90)
            picture.set_can_shrink(True)
        except Exception as e:
            print(f"Konnte Wallpaper nicht laden: {path} – {e}")
            return

        name = os.path.basename(path)
        display_name = name if len(name) <= 24 else name[:21] + "…"

        name_label = Gtk.Label(label=display_name)
        name_label.set_ellipsize(3)
        name_label.set_max_width_chars(20)
        name_label.set_halign(Gtk.Align.CENTER)
        name_label.set_margin_top(2)

        check_label = Gtk.Label()
        check_label.set_markup(
            "<span foreground='white' weight='bold' size='x-large'>✓</span>"
        )
        check_label.set_halign(Gtk.Align.END)
        check_label.set_valign(Gtk.Align.START)
        check_label.set_margin_top(4)
        check_label.set_margin_end(6)
        check_label.set_visible(False)

        overlay = Gtk.Overlay()
        overlay.set_child(picture)
        overlay.add_overlay(check_label)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        vbox.set_halign(Gtk.Align.CENTER)
        vbox.set_margin_top(4)
        vbox.set_margin_bottom(4)
        vbox.set_margin_start(4)
        vbox.set_margin_end(4)
        vbox.append(overlay)
        vbox.append(name_label)

        frame = Gtk.Frame()
        frame.set_child(vbox)
        frame.add_css_class("wallpaper-thumb-frame")

        child = Gtk.FlowBoxChild()
        child.set_child(frame)
        child.set_tooltip_text(f"{name}\n\nDoppelklick für große Vorschau")
        flowbox.append(child)

        self.wallpaper_map[child] = path
        self.wallpaper_frames[child] = frame
        self.wallpaper_check_labels[child] = check_label

    def _clear_all_selections_visuals(self):
        for frame in self.wallpaper_frames.values():
            try:
                frame.remove_css_class("wallpaper-thumb-frame-selected")
            except Exception:
                pass
        for lbl in self.wallpaper_check_labels.values():
            try:
                lbl.set_visible(False)
            except Exception:
                pass

    def _on_wallpaper_thumb_selected(self, flowbox):
        self._clear_all_selections_visuals()

        selected = flowbox.get_selected_children()
        if not selected:
            return

        child = selected[0]
        path = self.wallpaper_map.get(child)
        if not path:
            return

        frame = self.wallpaper_frames.get(child)
        if frame is not None:
            try:
                frame.add_css_class("wallpaper-thumb-frame-selected")
            except Exception:
                pass

        check_lbl = self.wallpaper_check_labels.get(child)
        if check_lbl is not None:
            try:
                check_lbl.set_visible(True)
            except Exception:
                pass

        for fb in self.wallpaper_flowboxes:
            if fb is not flowbox:
                try:
                    fb.unselect_all()
                except Exception:
                    pass

        self.selected_wallpaper = path
        self._update_wallpaper_info(path)

    def _on_wallpaper_thumb_activated(self, flowbox, child):
        path = self.wallpaper_map.get(child)
        if not path:
            return
        self._open_wallpaper_preview(path)

    def _open_wallpaper_preview(self, path):
        try:
            preview = Adw.Window()
            preview.set_transient_for(self.window)
            preview.set_modal(True)
            preview.set_title(os.path.basename(path))
            preview.set_default_size(950, 720)

            toolbar_view = Adw.ToolbarView()
            header = Adw.HeaderBar()
            toolbar_view.add_top_bar(header)

            scrolled = Gtk.ScrolledWindow()
            scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            scrolled.add_css_class("wallpaper-scroll")

            picture = Gtk.Picture.new_for_filename(path)
            picture.set_can_shrink(True)
            picture.set_content_fit(Gtk.ContentFit.CONTAIN)

            scrolled.set_child(picture)
            toolbar_view.set_content(scrolled)

            preview.set_content(toolbar_view)
            preview.present()
        except Exception as e:
            self.show_message_dialog(
                "Vorschau fehlgeschlagen",
                f"Das Bild konnte nicht angezeigt werden:\n\n{e}",
                is_error=True
            )

    def _open_custom_file_chooser(self, button):
        try:
            dialog = Gtk.FileChooserNative.new(
                "Eigenes Wallpaper auswählen",
                self.window,
                Gtk.FileChooserAction.OPEN,
                "Auswählen",
                "Abbrechen"
            )

            bilder_path = WALLPAPER_USER_DIR
            if os.path.isdir(bilder_path):
                try:
                    dialog.set_current_folder(Gio.File.new_for_path(bilder_path))
                except Exception:
                    pass

            img_filter = Gtk.FileFilter()
            img_filter.set_name("Bilder")
            for ext in ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.bmp",
                        "*.JPG", "*.JPEG", "*.PNG"]:
                img_filter.add_pattern(ext)
            dialog.add_filter(img_filter)

            all_filter = Gtk.FileFilter()
            all_filter.set_name("Alle Dateien")
            all_filter.add_pattern("*")
            dialog.add_filter(all_filter)

            dialog.connect("response", self._on_custom_file_chosen)
            dialog.show()
        except Exception as e:
            self.show_message_dialog(
                "Datei-Browser fehlgeschlagen",
                f"Der Datei-Browser konnte nicht geöffnet werden:\n\n{e}",
                is_error=True
            )

    def _on_custom_file_chosen(self, dialog, response):
        try:
            if response == Gtk.ResponseType.ACCEPT:
                gfile = dialog.get_file()
                if gfile:
                    path = gfile.get_path()
                    if path and os.path.isfile(path):
                        self.selected_wallpaper = path
                        self._clear_all_selections_visuals()
                        for fb in self.wallpaper_flowboxes:
                            try:
                                fb.unselect_all()
                            except Exception:
                                pass
                        self._update_wallpaper_info(path)
        except Exception as e:
            print(f"Fehler bei der Dateiauswahl: {e}")
        finally:
            dialog.destroy()

