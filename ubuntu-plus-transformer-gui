def _first_existing_dir(candidates, default=""):
    for d in candidates:
        if os.path.isdir(d):
            return d
    return default


def check_flatpak_app(app_id):
    try:
        result = subprocess.run(
            ["flatpak", "list", "--app", "--columns=application"],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode != 0:
            return False
        return app_id in result.stdout
    except Exception:
        return False


def check_snap_package(name):
    try:
        result = subprocess.run(
            ["snap", "list", name],
            capture_output=True, text=True, timeout=5
        )
        return result.returncode == 0 and name in result.stdout
    except Exception:
        return False


def _is_live_session():
    """Prüft zuverlässig, ob wir in einer Live-Session laufen.

    Rückgabe: (bool, str) – True/False und ein Grund-String.
    """
    # Prüfung 1: Kernel-Cmdline (Ubuntu/Debian Live)
    try:
        with open("/proc/cmdline", "r") as f:
            cmdline = f.read()
        if "boot=casper" in cmdline or "boot=live" in cmdline:
            return True, "Kernel-Cmdline enthält boot=casper oder boot=live"
    except Exception:
        pass

    # Prüfung 2: Casper/Overlay-Verzeichnisse
    for d in ("/run/casper", "/rofs", "/cow"):
        if os.path.isdir(d):
            return True, f"Casper/Overlay-Verzeichnis gefunden: {d}"

    # Prüfung 3: Root-Dateisystem-Typ
    try:
        result = subprocess.run(
            ["findmnt", "-n", "-o", "FSTYPE", "/"],
            capture_output=True, text=True, timeout=3
        )
        fstype = result.stdout.strip()
        if fstype in ("overlay", "squashfs"):
            return True, f"Root-Dateisystem ist {fstype}"
    except Exception:
        pass

    return False, ""


def get_real_username():
    """Nur für Log-/Info-Zwecke in der GUI (CLI nutzt PKEXEC_UID)."""
    for var in ("SUDO_USER", "USER", "LOGNAME"):
        val = os.environ.get(var)
        if val and val != "root":
            return val
    uid = os.environ.get("PKEXEC_UID")
    if uid:
        try:
            return pwd.getpwuid(int(uid)).pw_name
        except Exception:
            pass
    try:
        return pwd.getpwuid(os.stat(os.path.expanduser("~")).st_uid).pw_name
    except Exception:
        return ""


