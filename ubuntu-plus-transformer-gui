    def do_activate(self):
        try:
            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(WALLPAPER_CSS)
            display = Gdk.Display.get_default()
            if display:
                Gtk.StyleContext.add_provider_for_display(
                    display,
                    css_provider,
                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
                )
        except Exception as e:
            print(f"CSS-Provider konnte nicht geladen werden: {e}")

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("Ubuntu-PLUS Transformer")
        self.window.set_default_size(750, 650)
        self.window.set_resizable(False)

        self.detect_installed_packages()

        # ─────────────────────────────────────────────
        # Live-System-Erkennung: Vor allen weiteren Schritten
        # prüfen, ob wir in einer Live-Session laufen.
        # ─────────────────────────────────────────────
        is_live, live_reason = _is_live_session()
        if is_live:
            self.show_live_warning(live_reason)
            return

        if not self.vm_checked and self.is_vm():
            self.vm_checked = True
            self.show_vm_warning()
            return

        self.build_ui()

    def detect_installed_packages(self):
        try:
            self.brave_installed   = check_flatpak_app("com.brave.Browser")
            self.vivaldi_installed = check_flatpak_app("com.vivaldi.Vivaldi")
            self.chrome_installed  = check_flatpak_app("com.google.Chrome")

            self.firefox_snap_installed    = check_snap_package("firefox")
            self.firefox_flatpak_installed = check_flatpak_app("org.mozilla.firefox")
            self.firefox_installed = (
                self.firefox_snap_installed or self.firefox_flatpak_installed
            )
        except Exception as e:
            print(f"Erkennung fehlgeschlagen: {e}")

    def is_vm(self):
        try:
            result = subprocess.run(
                ["systemd-detect-virt"],
                capture_output=True, text=True
            )
            virt_type = result.stdout.strip()
            return virt_type != "none" and virt_type != ""
        except Exception:
            return False

