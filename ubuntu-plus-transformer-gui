        dialog.connect("response", self._on_success_dialog_response)
        dialog.present()

    def _on_success_dialog_response(self, dialog, response):
        dialog.destroy()
        if response == 1:
            # Reboot: Erst Info-Dialog, dann direkt pkexec reboot.
            # Keine 20-Sekunden-Wartezeit – der Boot-Time-Service
            # entfernt den Transformer ohnehin nach dem Reboot.
            self._show_reboot_info_dialog()
        elif response == 2:
            # Beenden: systemd-run-Timer (20s) läuft im CLI im
            # Hintergrund und entfernt den Transformer noch in dieser
            # Sitzung. Der User kann den PC normal weiterbenutzen.
            self.quit()

    def _show_reboot_info_dialog(self):
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            modal=True,
            text="🔄 Neustart wird vorbereitet",
            secondary_text=(
                "Der Ubuntu-PLUS Transformer wird sich automatisch "
                "entfernen – entweder noch vor dem Neustart oder direkt "
                "nach dem nächsten Boot.\n\n"
                "Deine Wallpaper, Icons und Einstellungen bleiben erhalten.\n\n"
                "⚠️  Für den Neustart wird gleich dein Administrator-Passwort "
                "abgefragt. Das ist bei einem Systemneustart normal – bitte "
                "gib es ein, damit der Rechner neu starten kann."
            )
        )
        dialog.add_button("❌ Abbrechen", Gtk.ResponseType.CANCEL)
        ok_btn = dialog.add_button("🔄 Jetzt neu starten", Gtk.ResponseType.OK)
        ok_btn.add_css_class("suggested-action")
        dialog.connect("response", self._on_reboot_confirmed)
        dialog.present()

    def _on_reboot_confirmed(self, dialog, response):
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            # pkexec-Aufruf direkt – Passwort-Dialog kommt sofort
            try:
                subprocess.run(["pkexec", "reboot"], check=False)
            except Exception as e:
                self.show_message_dialog("Fehler beim Neustart", str(e), is_error=True)
            self.quit()

