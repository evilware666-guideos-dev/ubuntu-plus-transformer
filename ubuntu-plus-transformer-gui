        dialog = Adw.MessageDialog(
            transient_for=self.window,
            modal=True,
            heading="❌ Live-System erkannt",
            body=(
                f"Der Ubuntu-PLUS Transformer kann in einer Live-Session "
                f"nicht ausgeführt werden.\n\n"
                f"Grund: {reason}\n\n"
                f"Das Tool installiert sehr viele Pakete (mehrere hundert MB). "
                f"In einer Live-Session liegt das Root-Dateisystem vollständig "
                f"im RAM – das führt zu Speichermangel und bricht mittendrin ab.\n\n"
                f"Bitte installiere Ubuntu zuerst auf die Festplatte und starte "
                f"den Transformer dann im installierten System erneut."
            )
