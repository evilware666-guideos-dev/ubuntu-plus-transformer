        _auto_state = {"last": None}

        def _sync_default_to_install(radio, chk, icon_key):
            if not radio.get_active():
                return
            prev = _auto_state["last"]
            if prev and prev != icon_key:
                prev_chk = getattr(self, f'icon_{prev}_chk', None)
                if prev_chk is not None and prev_chk.get_active():
                    prev_chk.set_active(False)
            if chk is not None and not chk.get_active():
                chk.set_active(True)
            _auto_state["last"] = icon_key

        self.radio_whitesur.connect("toggled", lambda r: _sync_default_to_install(r, self.icon_whitesur_chk, "whitesur"))
        self.radio_minty.connect("toggled",    lambda r: _sync_default_to_install(r, self.icon_minty_chk,    "minty"))
        self.radio_we10x.connect("toggled",    lambda r: _sync_default_to_install(r, self.icon_we10x_chk,    "we10x"))
        self.radio_breeze.connect("toggled",   lambda r: _sync_default_to_install(r, self.icon_breeze_chk,   "breeze"))
        self.radio_zorin.connect("toggled",    lambda r: _sync_default_to_install(r, self.icon_zorin_chk,    "zorin"))
        self.radio_moka.connect("toggled",     lambda r: _sync_default_to_install(r, self.icon_moka_chk,     "moka"))
        self.radio_numix.connect("toggled",    lambda r: _sync_default_to_install(r, self.icon_numix_chk,    "numix"))
        self.radio_pop.connect("toggled",      lambda r: _sync_default_to_install(r, self.icon_pop_chk,      "pop"))
        self.radio_papirus.connect("toggled",  lambda r: _sync_default_to_install(r, self.icon_papirus_chk,  "papirus"))
        self.radio_yaru.connect("toggled",     lambda r: _sync_default_to_install(r, None,                    "yaru"))

        def _check_uncheck_default(chk, radio):
            if not chk.get_active() and radio.get_active():
                if radio == self.radio_yaru:
                    return
                dialog = Gtk.MessageDialog(
                    transient_for=self.window,
                    modal=True,
                    text="⚠️ Standard-Icon nicht zur Installation ausgewählt!",
                    secondary_text=(
                        f"Du hast „{radio.get_label()}“ als Standard-Icon-Set gewählt,\n"
                        f"aber „{chk.get_label()}“ ist nicht zur Installation ausgewählt.\n\n"
                        "Das Icon-Set wird nach der Installation NICHT verfügbar sein,\n"
                        "und dein System wird auf das Standard-Theme zurückfallen.\n\n"
                        "Möchtest du es automatisch mit installieren?"
                    )
                )
                dialog.add_button("❌ Nein, nicht installieren", Gtk.ResponseType.NO)
                install_btn = dialog.add_button("✅ Ja, mit installieren", Gtk.ResponseType.YES)
                install_btn.add_css_class("suggested-action")

                def _on_response(d, resp):
                    d.destroy()
                    if resp == Gtk.ResponseType.YES:
                        chk.set_active(True)

