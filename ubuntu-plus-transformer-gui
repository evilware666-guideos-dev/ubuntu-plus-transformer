    def start_pulse(self):
        self.progress_bar.set_text("Installation läuft ...")
        self.progress_bar.set_fraction(0.0)
        self.pulse_timer = GLib.timeout_add(100, self._pulse_callback)

    def _pulse_callback(self):
        self.progress_bar.pulse()
        return True

    def stop_pulse(self, success=True):
        if self.pulse_timer is not None:
            GLib.source_remove(self.pulse_timer)
            self.pulse_timer = None
        if success:
            self.progress_bar.set_fraction(1.0)
            self.progress_bar.set_text("✅ Installation abgeschlossen!")
        else:
            self.progress_bar.set_text("❌ Installation fehlgeschlagen")

