        threading.Thread(
            target=self._scan_wallpapers_async,
            daemon=True
        ).start()

    def _scan_dir(self, path, recursive=False, max_depth=2):
        result = []
        if not os.path.isdir(path):
            return result

        def _walk(current, depth):
            try:
                entries = sorted(os.listdir(current))
            except Exception:
                return
            for name in entries:
                full = os.path.join(current, name)
                if os.path.isfile(full) and name.lower().endswith(IMAGE_EXTS):
                    result.append(full)
                elif recursive and os.path.isdir(full) and depth < max_depth:
                    _walk(full, depth + 1)

        _walk(path, 0)
        return result

    def _scan_wallpapers_async(self):
        try:
            log_lines = []
            log_lines.append("=" * 60)
            log_lines.append("Wallpaper-Scan:")
            log_lines.append(f"Skript-Verzeichnis: {SCRIPT_DIR}")

            extra_files = []
            found_extra_dirs = []
            checked_extra = []
            seen_extra_realpaths = set()
            for extra_dir in WALLPAPER_EXTRA_CANDIDATES:
                real = os.path.realpath(extra_dir)
                if real in seen_extra_realpaths:
                    continue
                seen_extra_realpaths.add(real)
                exists = os.path.isdir(extra_dir)
                checked_extra.append(f"[{'✓' if exists else '✗'}] {extra_dir}")
                if exists:
                    files_here = self._scan_dir(extra_dir)
                    if files_here:
                        found_extra_dirs.append(f"{extra_dir} ({len(files_here)} Dateien)")
                        extra_files.extend(files_here)
                        log_lines.append(f"  📁 Extra: {extra_dir} → {len(files_here)} Bilder")
                    else:
                        log_lines.append(f"  📁 Extra (leer): {extra_dir}")

            if not found_extra_dirs:
                log_lines.append("  📁 Extra: KEIN Extra-Wallpaper gefunden.")
                log_lines.append("     Geprüfte Pfade:")
                for line in checked_extra:
                    log_lines.append(f"      {line}")

            plus_files = []
            plus_dir_found = ""
            for d in WALLPAPER_PLUS_CANDIDATES:
                if os.path.isdir(d):
                    files_here = self._scan_dir(d)
                    if files_here:
                        plus_dir_found = d
                        plus_files.extend(files_here)
                        log_lines.append(f"  📁 PLUS: {d} → {len(files_here)} Bilder")
                        break
            if not plus_dir_found:
                log_lines.append("  📁 PLUS: kein PLUS-Wallpaper-Ordner gefunden.")

            ubuntu_files = []
            ubuntu_dir_found = ""
            for d in WALLPAPER_UBUNTU_CANDIDATES:
                if os.path.isdir(d):
                    files_here = self._scan_dir(d, recursive=True, max_depth=2)
                    if files_here:
                        ubuntu_dir_found = d
                        ubuntu_files.extend(files_here)
                        log_lines.append(f"  📁 Ubuntu: {d} → {len(files_here)} Bilder")
                        break

            user_files = self._scan_dir(WALLPAPER_USER_DIR)
            log_lines.append(f"  📁 Eigenes ({WALLPAPER_USER_DIR}): {len(user_files)} Bilder (vor Dedup)")

            seen = set()
            def dedupe(paths):
                result = []
                for p in paths:
                    name = os.path.basename(p)
                    if name in seen:
                        continue
                    seen.add(name)
                    result.append(p)
                return result

            extra_files  = dedupe(extra_files)
            plus_files   = dedupe(plus_files)
            ubuntu_files = dedupe(ubuntu_files)
            user_files   = dedupe(user_files)

            log_lines.append(
                f"  Nach Dedup: Extra={len(extra_files)} · PLUS={len(plus_files)} · "
                f"Ubuntu={len(ubuntu_files)} · Eigenes={len(user_files)}"
            )
            log_lines.append("=" * 60)

            for line in log_lines:
                print(line)

            GLib.idle_add(
                self._on_scan_complete,
                user_files, extra_files, plus_files, ubuntu_files, log_lines
            )
        except Exception as e:
            import traceback
            traceback.print_exc()
            GLib.idle_add(self._on_scan_error, str(e))

    def _on_scan_complete(self, user_files, extra_files, plus_files, ubuntu_files, log_lines):
        self.wallpaper_scan_running = False

        min_display_us = 1_500_000
        if self.wallpaper_scan_start_time is not None:
            elapsed = GLib.get_monotonic_time() - self.wallpaper_scan_start_time
            delay_us = max(0, min_display_us - elapsed)
            delay_ms = int(delay_us / 1000)
        else:
            delay_ms = 0

        print(f"   → Scan dauerte, warte noch {delay_ms} ms für Mindestanzeige")

        GLib.timeout_add(
            delay_ms,
            self._finalize_scan,
            user_files, extra_files, plus_files, ubuntu_files
        )
        return False

    def _finalize_scan(self, user_files, extra_files, plus_files, ubuntu_files):
        while True:
            child = self.wallpaper_content_box.get_first_child()
            if child is None:
                break
            self.wallpaper_content_box.remove(child)

        self.wallpaper_map.clear()
        self.wallpaper_frames.clear()
        self.wallpaper_check_labels.clear()
        self.wallpaper_flowboxes.clear()

        self._gallery_tasks = []
        self._gallery_tasks.append(("🖼️ Eigenes Wallpaper", user_files, True))
        if extra_files:
            self._gallery_tasks.append(("🌟 Extra Wallpaper", extra_files, False))
        if plus_files:
            self._gallery_tasks.append(("🎨 Ubuntu-PLUS Wallpaper", plus_files, False))
        if ubuntu_files:
            self._gallery_tasks.append(("🐧 Ubuntu Standard Wallpaper", ubuntu_files, False))

        self._gallery_task_idx = 0
        self._gallery_path_idx = 0
        self._gallery_current_flowbox = None

        GLib.idle_add(self._build_gallery_chunk)
        return False

    def _build_gallery_chunk(self):
        MAX_CHUNK_TIME = 0.03
        start = time.time()

        while self._gallery_task_idx < len(self._gallery_tasks):
            if time.time() - start > MAX_CHUNK_TIME:
                GLib.idle_add(self._build_gallery_chunk)
                return False

            title_text, paths, with_chooser = self._gallery_tasks[self._gallery_task_idx]

            if self._gallery_path_idx == 0:
                self._add_wallpaper_section_header(title_text, with_chooser)
                self._gallery_current_flowbox = self._create_flowbox()
                self.wallpaper_content_box.append(self._gallery_current_flowbox)
                self.wallpaper_flowboxes.append(self._gallery_current_flowbox)

            if self._gallery_path_idx < len(paths):
                self._add_wallpaper_thumb(
                    self._gallery_current_flowbox,
                    paths[self._gallery_path_idx]
                )
                self._gallery_path_idx += 1
            else:
                self._gallery_task_idx += 1
                self._gallery_path_idx = 0
                self._gallery_current_flowbox = None

        if not self.wallpaper_map:
            empty = Gtk.Label()
            empty.set_markup(
                "<span foreground='#9a9996'><i>Keine Wallpaper gefunden.</i></span>"
            )
            empty.set_halign(Gtk.Align.CENTER)
            empty.set_margin_top(40)
            self.wallpaper_content_box.append(empty)

        self.wallpaper_spinner.stop()
        self.wallpaper_spinner.set_visible(False)
        self.wallpaper_progress_label.set_visible(False)
        self.wallpaper_status_label.set_visible(False)

        self.wallpaper_populated = True
        self.wallpaper_info_label.set_visible(True)
        self.wallpaper_scan_start_time = None
        return False

    def _on_scan_error(self, msg):
        self.wallpaper_scan_running = False
        self.wallpaper_spinner.stop()
        self.wallpaper_spinner.set_visible(False)
        self.wallpaper_progress_label.set_visible(False)
        self.wallpaper_status_label.set_markup(
            f"<span foreground='#e01b24' weight='bold'>❌ Scan fehlgeschlagen: {msg}</span>"
        )
        self.wallpaper_status_label.set_visible(True)
        return False

