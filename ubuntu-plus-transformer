# =========================================================
# ZEITSYNCHRONISATION
# =========================================================
fix_system_time() {
    echo ">>> Prüfe Systemzeit ..."

    if ! command -v timedatectl &>/dev/null; then
        echo "   ⚠️ timedatectl nicht gefunden – überspringe Zeitsynchronisation."
        return 0
    fi

    echo "   Aktuelle Systemzeit: $(date)"

    local ntp_status
    ntp_status=$(timedatectl show --property=NTPSynchronized --value 2>/dev/null)
    if [[ "$ntp_status" == "yes" ]]; then
        echo "   ✅ NTP ist bereits aktiv und Zeit synchronisiert."
        return 0
    fi

    echo "   ⏰ Systemzeit wird korrigiert ..."

    if command -v chronyc &>/dev/null; then
        echo "   → Führe chronyc makestep aus ..."
        if chronyc makestep 2>/dev/null; then
            echo "   ✅ chronyc makestep erfolgreich."
            sleep 2
            if timedatectl show --property=NTPSynchronized --value 2>/dev/null | grep -q "yes"; then
                echo "   ✅ Zeit erfolgreich synchronisiert."
                echo "   Neue Systemzeit: $(date)"
                return 0
            fi
        fi
    fi

    echo "   → Versuche direkte NTP-Synchronisation via ntpdate ..."
    if ! command -v ntpdate &>/dev/null; then
        echo "   → Installiere ntpdate ..."
        apt install -y ntpdate 2>/dev/null || true
    fi

    if command -v ntpdate &>/dev/null; then
        if ntpdate -u pool.ntp.org 2>/dev/null; then
            echo "   ✅ Systemzeit über ntpdate synchronisiert."
            hwclock --systohc 2>/dev/null || true
            echo "   Neue Systemzeit: $(date)"
            return 0
        fi
    fi

    echo "   → Versuche manuelle Zeitsynchronisation über HTTP ..."
    local time_server="http://time.google.com"
    local time_str
    time_str=$(curl -s --head "$time_server" 2>/dev/null | grep -i "^date:" | sed 's/^[Dd]ate: //')
    if [[ -z "$time_str" ]]; then
        time_server="http://www.google.com"
        time_str=$(curl -s --head "$time_server" 2>/dev/null | grep -i "^date:" | sed 's/^[Dd]ate: //')
    fi

    if [[ -n "$time_str" ]]; then
        echo "   📅 Empfangene Zeit: $time_str"
        local epoch_time
        epoch_time=$(date -d "$time_str" +%s 2>/dev/null)
        if [[ -n "$epoch_time" ]]; then
            echo "   ⏰ Setze Systemzeit auf $epoch_time ..."
            if date -s "@$epoch_time" >/dev/null 2>&1; then
                echo "   ✅ Systemzeit manuell gesetzt."
                hwclock --systohc 2>/dev/null || true
                timedatectl set-ntp true 2>/dev/null || true
                echo "   Neue Systemzeit: $(date)"
                return 0
            fi
        fi
    fi

    echo "   ⚠️ Zeit konnte nicht automatisch synchronisiert werden."
    echo "   ⚠️ Fahre trotzdem fort, aber APT könnte Probleme machen."
    return 0
}
