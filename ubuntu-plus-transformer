    fi

    if flatpak list --app 2>/dev/null | grep -q "$app_id"; then
        echo "   ⚠️  Test fehlgeschlagen: $name ($app_id) weiterhin installiert."
        return 1
    else
        echo "   ✅ Test OK: $name wurde entfernt."
    fi
}

