install_office_suite() {
    local target="$1"
    local ver

    local has_libreoffice=false
    local has_onlyoffice=false
    local has_abiword=false
    local has_gnumeric=false

    if command -v libreoffice >/dev/null 2>&1 \
       || command -v soffice >/dev/null 2>&1 \
       || dpkg -l 'libreoffice*' 2>/dev/null | grep -q '^ii'; then
        has_libreoffice=true
    fi

    if { command -v flatpak >/dev/null 2>&1 \
         && flatpak list --app 2>/dev/null | grep -q "org.onlyoffice.desktopeditors"; } \
       || dpkg -l onlyoffice-desktopeditors 2>/dev/null | grep -q '^ii'; then
        has_onlyoffice=true
    fi

    if command -v abiword >/dev/null 2>&1 || \
       { command -v flatpak >/dev/null 2>&1 && flatpak list --app 2>/dev/null | grep -q "com.abisource.AbiWord"; }; then
        has_abiword=true
    fi

    if command -v gnumeric >/dev/null 2>&1 || \
       { command -v flatpak >/dev/null 2>&1 && flatpak list --app 2>/dev/null | grep -q "org.gnumeric.Gnumeric"; }; then
        has_gnumeric=true
    fi

    echo ">>> Office-Ziel: $target"
    echo "   Aktueller Zustand: LibreOffice=$has_libreoffice, ONLYOFFICE=$has_onlyoffice, AbiWord=$has_abiword, Gnumeric=$has_gnumeric"

    if [[ "$target" != "libreoffice" ]] && [[ "$has_libreoffice" == "true" ]]; then
        echo ">>> Entferne LibreOffice (nicht mehr Ziel-Suite) ..."
        apt purge -y 'libreoffice*' 2>/dev/null || true
        apt autoremove -y 2>/dev/null || true
        echo "   ✅ LibreOffice entfernt."
    fi

    if [[ "$target" != "onlyoffice" ]] && [[ "$has_onlyoffice" == "true" ]]; then
        echo ">>> Entferne ONLYOFFICE Desktop Editors ..."
        if command -v flatpak >/dev/null 2>&1; then
            flatpak uninstall -y org.onlyoffice.desktopeditors 2>/dev/null || true
            flatpak uninstall -y --delete-data org.onlyoffice.desktopeditors 2>/dev/null || true
        fi
        apt purge -y onlyoffice-desktopeditors 2>/dev/null || true
        apt autoremove -y 2>/dev/null || true
        echo "   ✅ ONLYOFFICE entfernt."
    fi

    if [[ "$target" != "abiword" ]] && [[ "$has_abiword" == "true" || "$has_gnumeric" == "true" ]]; then
        echo ">>> Entferne AbiWord + Gnumeric ..."
        apt purge -y abiword gnumeric 2>/dev/null || true
        apt autoremove -y 2>/dev/null || true
        if command -v flatpak >/dev/null 2>&1; then
            flatpak uninstall -y com.abisource.AbiWord 2>/dev/null || true
            flatpak uninstall -y org.gnumeric.Gnumeric 2>/dev/null || true
            flatpak uninstall -y --delete-data com.abisource.AbiWord 2>/dev/null || true
            flatpak uninstall -y --delete-data org.gnumeric.Gnumeric 2>/dev/null || true
        fi
        echo "   ✅ AbiWord + Gnumeric entfernt."
    fi

    case "$target" in
        libreoffice)
            if [[ "$has_libreoffice" == "true" ]]; then
                echo ">>> LibreOffice ist bereits installiert – überspringe Neuinstallation."
            else
                echo ">>> Büro-Software: LibreOffice wird installiert ..."
                apt install -y libreoffice
                if command -v libreoffice >/dev/null 2>&1 || command -v soffice >/dev/null 2>&1; then
                    ver=$(libreoffice --version 2>/dev/null | head -n1 || echo "unbekannt")
                    echo "   ✅ Test OK: $ver"
                else
                    echo "   ⚠️  Test fehlgeschlagen: 'libreoffice' nicht im PATH."
                    return 1
                fi
            fi
            ;;

        onlyoffice)
            echo ">>> Büro-Software: ONLYOFFICE Desktop Editors wird als Flatpak installiert ..."
            if ! command -v flatpak >/dev/null 2>&1; then
                echo "   ⚠️  Flatpak ist nicht verfügbar – ONLYOFFICE kann nicht installiert werden."
                return 1
            fi
            if flatpak list --app 2>/dev/null | grep -q "org.onlyoffice.desktopeditors"; then
                echo "   ✅ ONLYOFFICE ist bereits installiert – überspringe Neuinstallation."
            else
                flatpak remote-add --if-not-exists flathub \
                    https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
                flatpak install -y flathub org.onlyoffice.desktopeditors
                if flatpak list --app 2>/dev/null | grep -q "org.onlyoffice.desktopeditors"; then
                    echo "   ✅ Test OK: ONLYOFFICE Desktop Editors (Flatpak) installiert."
                else
                    echo "   ⚠️  Test fehlgeschlagen: Flatpak-Installation nicht gefunden."
                    return 1
                fi
            fi
            ;;

        abiword)
            if command -v gnumeric >/dev/null 2>&1 || \
               { command -v flatpak >/dev/null 2>&1 && flatpak list --app 2>/dev/null | grep -q "org.gnumeric.Gnumeric"; }; then
                echo "   ✅ Gnumeric ist bereits installiert – überspringe."
            else
                echo ">>> Installiere Gnumeric ..."
                GNUMERIC_INSTALLED=false

                if apt-cache policy gnumeric 2>/dev/null | grep -q "Candidate:"; then
                    echo "   → Installiere Gnumeric über APT ..."
                    if apt install -y gnumeric; then
                        if command -v gnumeric >/dev/null 2>&1; then
                            echo "   ✅ Test OK: Gnumeric über APT installiert."
                            GNUMERIC_INSTALLED=true
                        fi
                    fi
                fi

                if [[ "$GNUMERIC_INSTALLED" != "true" ]]; then
                    if command -v flatpak >/dev/null 2>&1; then
                        echo "   → Installiere Gnumeric über Flatpak (Fallback) ..."
                        flatpak remote-add --if-not-exists flathub \
                            https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
                        flatpak install -y flathub org.gnumeric.Gnumeric
                        if flatpak list --app 2>/dev/null | grep -q "org.gnumeric.Gnumeric"; then
                            echo "   ✅ Test OK: Gnumeric (Flatpak) installiert."
                            GNUMERIC_INSTALLED=true
                        fi
                    fi
                fi

                if [[ "$GNUMERIC_INSTALLED" != "true" ]]; then
                    echo "   ⚠️  Gnumeric konnte nicht installiert werden – AbiWord wird trotzdem versucht."
                fi
            fi

            if command -v abiword >/dev/null 2>&1 || \
               { command -v flatpak >/dev/null 2>&1 && flatpak list --app 2>/dev/null | grep -q "com.abisource.AbiWord"; }; then
                echo "   ✅ AbiWord ist bereits installiert – überspringe."
            else
                echo ">>> Installiere AbiWord ..."
                if apt-cache policy abiword 2>/dev/null | grep -q "Candidate:"; then
                    echo "   → Installiere AbiWord über APT ..."
                    apt install -y abiword
                    if command -v abiword >/dev/null 2>&1; then
                        ver=$(abiword --version 2>/dev/null | head -n1 || echo "unbekannt")
                        echo "   ✅ Test OK: AbiWord ($ver) über APT installiert."
                    else
                        echo "   ⚠️  Test fehlgeschlagen: 'abiword' nicht im PATH."
                        return 1
                    fi
                else
                    echo "   ℹ️  AbiWord ist nicht im APT-Repo – installiere Flatpak-Version ..."
                    if command -v flatpak >/dev/null 2>&1; then
                        flatpak remote-add --if-not-exists flathub \
                            https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
                        flatpak install -y flathub com.abisource.AbiWord
                        if flatpak list --app 2>/dev/null | grep -q "com.abisource.AbiWord"; then
                            echo "   ✅ Test OK: AbiWord (Flatpak) installiert."
                        else
                            echo "   ⚠️  Test fehlgeschlagen: Flatpak-Installation nicht gefunden."
