DONE_WALLPAPERS=${DONE_WALLPAPERS:-0}
DONE_BACKGROUNDS=${DONE_BACKGROUNDS:-0}
DONE_MUSIC=${DONE_MUSIC:-0}
DONE_GNOME_LAYOUT_DCONF=${DONE_GNOME_LAYOUT_DCONF:-0}
