echo "Icons: WHITESUR=$INSTALL_WHITESUR, MINTY=$INSTALL_MINTY, WE10X=$INSTALL_WE10X, BREEZE=$INSTALL_BREEZE, ZORIN=$INSTALL_ZORIN, MOKA=$INSTALL_MOKA, NUMIX=$INSTALL_NUMIX, POP=$INSTALL_POP, PAPIRUS=$INSTALL_PAPIRUS"
