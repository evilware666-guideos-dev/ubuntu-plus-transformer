#!/bin/bash
# Ubuntu-PLUS Transformer - Ubuntu in Ubuntu-PLUS transformieren.
# (c) 2026 – Freigegeben unter GPL v3
#
# Fixes in dieser Version:
#   • App-Grid: Kategorien alphabetisch (Virtualisierung vor Zubehör)
#   • app-picker-layout: Positionen 12/13 korrekt zugewiesen
#   • Utilities-Kategorie korrekt unter folders/Utilities (Slash statt Doppelpunkt)
#   • Live-System-Erkennung
#   • Wallpaper-Persistenz-Suche
#   • Live-Reload der GNOME-Sitzung (kein Logout nötig)
#   • Selbst-Deinstallation: systemd-run (sofort) + Boot-Time-Service (Sicherheitsnetz)
#   • Cleanup-Trap: unattended-upgrades wird bei Abbruch reaktiviert
#   • TIMER-BUG-FIX: UNATTENDED_STOPPED wird jetzt in beiden Schleifen gesetzt
#   • ENDGÜLTIGER UNMASK: am Ende wird immer unmaskt, unabhängig vom Status
#   • Firefox-Policies zusätzlich für Snap-Version hinterlegt
#   • Flatpak-Theme-Overrides für echten Benutzer (nicht root)
#   • needrestart wird auf "auto" gestellt (kein hängender Prompt)
#   • Logfile unter /var/log/ubuntu-plus-transformer.log
#   • Übergangs-Avatar (ubuntu-plus-transformer.png) bis Ubuntu den GNOME-46-Bug fixt
#   • Zorin-Icon-Name korrigiert: ZorinBlue-Dark (statt ZorinOS-dark)
#   • Yaru-Icon-Name korrigiert: Yaru-blue-dark (statt Yaru)
#   • Icon-Cache wird nach jedem Theme-Install aktualisiert
#   • Nautilus wird neu geladen, damit neue Icons sofort sichtbar sind
#   • State-File: erledigte Schritte und Nutzerauswahl werden in
#     /var/lib/ubuntu-plus-transformer/state.conf gespeichert. Beim zweiten
#     Lauf werden diese Schritte übersprungen. Über --force lässt sich ein
#     Neulauf erzwingen, über --reset wird der State gelöscht.

# ────────────── HANG-FIX ──────────────
export DEBIAN_FRONTEND=noninteractive

export NEEDRESTART_MODE=a
export NEEDRESTART_SUSPEND=1

echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections
echo "ttf-mscorefonts-installer msttcorefonts/present-mscorefonts-eula note" | debconf-set-selections
echo '* libraries/restart-without-asking boolean true' | debconf-set-selections
# ──────────────────────────────────────

set -e
set -o pipefail

# ────────────── LOGFILE ──────────────
LOG_FILE="/var/log/ubuntu-plus-transformer.log"
mkdir -p "$(dirname "$LOG_FILE")"
exec > >(tee -a "$LOG_FILE") 2>&1
echo ""
echo "════════════════════════════════════════════════════════════"
echo "=== Start: $(date) ==="
echo "════════════════════════════════════════════════════════════"
# ─────────────────────────────────────

# ────────────── EARLY CLEANUP-TRAP ──────────────
_UNATTENDED_BLOCKED=false
cleanup_early() {
    if [[ "$_UNATTENDED_BLOCKED" == "true" ]]; then
        echo ">>> [Cleanup] Reaktiviere automatische Updates ..."
        for service in unattended-upgrades apt-daily apt-daily-upgrade; do
            systemctl unmask "$service" 2>/dev/null || true
        done
        for timer in apt-daily.timer apt-daily-upgrade.timer; do
            systemctl unmask "$timer" 2>/dev/null || true
        done
        systemctl start apt-daily.timer 2>/dev/null || true
        systemctl start apt-daily-upgrade.timer 2>/dev/null || true
    fi
}
trap cleanup_early EXIT
# ───────────────────────────────────────────────

# ────────────── UNATTENDED-UPDATES KOMPLETT BLOCKIEREN ──────────────
echo ">>> Blockiere automatische Updates während der Installation ..."

UNATTENDED_STOPPED=false

for timer in apt-daily.timer apt-daily-upgrade.timer; do
    if systemctl is-active --quiet "$timer" 2>/dev/null; then
        echo "   ⏸️  Stoppe Timer: $timer"
        systemctl stop "$timer" 2>/dev/null || true
        systemctl mask "$timer" 2>/dev/null || true
        UNATTENDED_STOPPED=true
    fi
done

for service in unattended-upgrades apt-daily apt-daily-upgrade; do
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "   ⏸️  Stoppe Dienst: $service"
        systemctl stop "$service" 2>/dev/null || true
        systemctl mask "$service" 2>/dev/null || true
        UNATTENDED_STOPPED=true
    fi
done

_UNATTENDED_BLOCKED=true

echo "   ⏳ Warte, bis unattended-upgrades beendet ist ..."
for i in {1..10}; do
    if ! pgrep -x "unattended-upgr" >/dev/null 2>&1; then
        echo "   ✅ unattended-upgrades ist beendet."
        break
    fi
    sleep 1
done

if pgrep -x "unattended-upgr" >/dev/null 2>&1; then
    echo "   ⚠️  unattended-upgrades läuft noch – beende hart ..."
    pkill -f "unattended-upgr" 2>/dev/null || true
    sleep 2
fi

for lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock; do
    if [[ -f "$lock" ]]; then
        echo "   🗑️  Entferne Sperre: $lock"
        rm -f "$lock" 2>/dev/null || true
    fi
done

export DEBIAN_FRONTEND=noninteractive
export APT_OPTIONS="-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"

echo "   ✅ Automatische Updates blockiert."
