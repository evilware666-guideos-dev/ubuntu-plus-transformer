            for d in "${INCLUDE_DIRS[@]}"; do
                src="$BACKUP_CONTENT/$d"
                dst="$USER_HOME/$d"
                if [[ -d "$src" ]]; then
                    mkdir -p "$(dirname "$dst")"
                    rsync -a "$src/" "$dst/"
                fi
            done

            EXT_SRC="$BACKUP_CONTENT/gnome-extensions"
            EXT_DST="$USER_HOME/.local/share/gnome-shell/extensions"
