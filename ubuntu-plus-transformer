fi
step_mark DONE_FIREFOX_POLICY
state_save
fi

# ---------------------------------------------
# Firewall aktivieren
# ---------------------------------------------
if step_choice DONE_FIREWALL "Firewall (UFW)" \
        "$_ARG_SET_NO_FIREWALL" "$NO_FIREWALL" "$STATE_NO_FIREWALL"; then
if [[ "$NO_FIREWALL" != "true" ]]; then
    echo ">>> Firewall (UFW) aktivieren ..."
    ufw --force enable
    ufw default deny incoming
    ufw default allow outgoing
fi
step_mark DONE_FIREWALL
state_save
fi

# =============================================
# FLATPAK-INSTALLATION (GANZ AM ENDE)
# =============================================
if step DONE_FLATPAK "Flatpak-Installationen + Theme-Overrides"; then
echo ">>> Flatpak einrichten ..."
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

echo ">>> Weitere Flatpaks installieren ..."
flatpak install -y flathub \
    de.haeckerfelix.Shortwave \
    com.github.micahflee.torbrowser-launcher \
    com.mattjakeman.ExtensionManager \
    org.gtk.Gtk3theme.Adwaita-dark \
    org.localsend.localsend_app \
    com.bitwarden.desktop \
    com.rustdesk.RustDesk \
    net.codelogistics.webapps \
    com.github.tchx84.Flatseal \
    com.github.unrud.VideoDownloader

echo ">>> Flatpak-Theme für Benutzer $REAL_USER konfigurieren (GTK und Qt) ..."
if [[ -n "$REAL_USER" ]] && [[ "$REAL_USER" != "root" ]]; then
    sudo -u "$REAL_USER" flatpak override --user --env=GTK_THEME=Adwaita-dark 2>/dev/null || true
    sudo -u "$REAL_USER" flatpak override --user --env=QT_STYLE_OVERRIDE=Adwaita-dark 2>/dev/null || true
    sudo -u "$REAL_USER" flatpak override --user --env=QT_QPA_PLATFORMTHEME=gtk3 2>/dev/null || true
    echo "   ✅ Flatpak-Theme-Overrides für $REAL_USER gesetzt."
else
    echo "   ⚠️  Kein gültiger REAL_USER – Flatpak-Overrides übersprungen."
fi
step_mark DONE_FLATPAK
state_save
fi

# =============================================
# Standard-Icon-Theme setzen
# =============================================
if step_choice DONE_ICON_SET "Standard-Icon-Theme setzen" \
        "$_ARG_SET_DEFAULT_ICON" "$DEFAULT_ICON" "$STATE_DEFAULT_ICON"; then
if [[ -n "$DEFAULT_ICON" ]]; then
    echo ">>> Setze Standard-Icon-Set auf: $DEFAULT_ICON"
    case "$DEFAULT_ICON" in
        whitesur) ICON_NAME="WhiteSur-dark" ;;
        minty)    ICON_NAME="Mint-Y" ;;
        we10x)    ICON_NAME="We10X-dark" ;;
        breeze)   ICON_NAME="breeze-dark" ;;
        zorin)    ICON_NAME="ZorinBlue-Dark" ;;
        moka)     ICON_NAME="Moka" ;;
        numix)    ICON_NAME="Numix" ;;
        pop)      ICON_NAME="Pop" ;;
        papirus)  ICON_NAME="Papirus" ;;
        yaru)     ICON_NAME="Yaru-blue-dark" ;;
        *) ICON_NAME="$DEFAULT_ICON" ;;
    esac

    # ─── Validierung: existiert das Theme wirklich? ───
    USER_HOME_REAL="$(eval echo ~$REAL_USER)"
    if [[ ! -d "/usr/share/icons/$ICON_NAME" ]] \
       && [[ ! -d "$USER_HOME_REAL/.local/share/icons/$ICON_NAME" ]] \
       && [[ ! -d "$USER_HOME_REAL/.icons/$ICON_NAME" ]]; then
        echo "   ⚠️  Theme '$ICON_NAME' nicht gefunden – Fallback auf 'Yaru'"
        ICON_NAME="Yaru"
    else
        echo "   ✅ Theme '$ICON_NAME' vorhanden."
    fi

    # ─── Icon-Cache auffrischen ───
    if [[ -d "/usr/share/icons/$ICON_NAME" ]]; then
        echo "   → Aktualisiere Icon-Cache für '$ICON_NAME' ..."
        gtk-update-icon-cache -f -t "/usr/share/icons/$ICON_NAME" 2>/dev/null || true
    fi
    if [[ -d /usr/share/icons/hicolor ]]; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi

    # ─── Theme setzen ───
    if [[ -n "$REAL_USER" ]] && [[ "$REAL_USER" != "root" ]]; then
        user_uid=$(id -u "$REAL_USER" 2>/dev/null)
        dbus_socket="/run/user/$user_uid/bus"
        if [[ -S "$dbus_socket" ]]; then
            sudo -u "$REAL_USER" env DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_socket" \
                gsettings set org.gnome.desktop.interface icon-theme "$ICON_NAME" 2>/dev/null || true
        else
            sudo -u "$REAL_USER" gsettings set org.gnome.desktop.interface icon-theme "$ICON_NAME" 2>/dev/null || true
        fi
        echo "   ✅ Icon-Theme auf '$ICON_NAME' gesetzt."
    fi

    # ─── Nautilus neu laden, damit Icons sofort sichtbar sind ───
    if pgrep -u "$REAL_USER" nautilus >/dev/null 2>&1; then
        echo "   → Lade Nautilus neu (Icon-Refresh) ..."
        sudo -u "$REAL_USER" nautilus -q 2>/dev/null || true
        sleep 1
    fi
fi
step_mark DONE_ICON_SET
state_save
fi

# =============================================
# Abschließende Bereinigung
# =============================================
echo ">>> Abschließende Bereinigung ..."
apt autoremove -y ptyxis
apt update -y
apt upgrade -y
flatpak repair
flatpak uninstall --unused -y
flatpak update -y
apt autoremove --purge -y
apt autoclean -y
apt clean -y

find /tmp -mindepth 1 -maxdepth 1 -user root -mtime +1 -exec rm -rf {} + 2>/dev/null || true
find /var/tmp -mindepth 1 -maxdepth 1 -user root -mtime +1 -exec rm -rf {} + 2>/dev/null || true

# ────────────── UNATTENDED-UPDATES WIEDER AKTIVIEREN ──────────────
echo ">>> Stelle sicher, dass automatische Updates aktiv sind ..."
for service in unattended-upgrades apt-daily apt-daily-upgrade; do
    systemctl unmask "$service" 2>/dev/null || true
done
for timer in apt-daily.timer apt-daily-upgrade.timer; do
    systemctl unmask "$timer" 2>/dev/null || true
done
systemctl start apt-daily.timer 2>/dev/null || true
systemctl start apt-daily-upgrade.timer 2>/dev/null || true

echo "   Kontrolle:"
for unit in unattended-upgrades apt-daily.timer apt-daily-upgrade.timer; do
    state=$(systemctl is-enabled "$unit" 2>/dev/null || echo "unknown")
    echo "      $unit = $state"
done
echo "   ✅ Automatische Updates sind wieder aktiv."

_UNATTENDED_BLOCKED=false
# ──────────────────────────────────────────────────────────────────

# =============================================
# HINTERGRUNDBILD SETZEN – GANZ AM ENDE
# =============================================
if step_choice DONE_WALLPAPER_SET "Hintergrundbild setzen" \
        "$_ARG_SET_WALLPAPER" "$WALLPAPER" "$STATE_WALLPAPER"; then
if [[ -n "$WALLPAPER" ]]; then
    echo ""
    echo ">>> Setze Hintergrundbild: $WALLPAPER"

    WP_BASE=$(basename "$WALLPAPER")
    WP_FOUND=""

    if [[ -n "$REAL_USER" ]] && [[ "$REAL_USER" != "root" ]]; then
        USER_HOME="$(eval echo ~$REAL_USER)"
        for candidate in \
            "$USER_HOME/.local/share/backgrounds/$WP_BASE" \
            "$USER_HOME/Bilder/$WP_BASE" \
            "/usr/share/backgrounds/$WP_BASE" \
            "/usr/share/ubuntu-plus-transformer/backgrounds/$WP_BASE" \
            "/usr/share/ubuntu-plus-transformer/Wallpaper/$WP_BASE"; do
            if [[ -f "$candidate" ]]; then
                WP_FOUND="$candidate"
                echo "   ℹ️  Persistente Quelle gefunden: $candidate"
                break
            fi
        done
    fi

    if [[ -z "$WP_FOUND" ]]; then
        WP_FOUND="$WALLPAPER"
    fi

    WALLPAPER="$WP_FOUND"

    if [[ ! -f "$WALLPAPER" ]]; then
        echo "   ❌ Datei existiert nicht: $WALLPAPER"
    else
        if command -v python3 >/dev/null 2>&1; then
            WP_URI="file://$(python3 -c \
                'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' \
                "$WALLPAPER" 2>/dev/null || echo "${WALLPAPER// /%20}")"
        else
            WP_URI="file://${WALLPAPER// /%20}"
        fi

        WP_DIR=$(dirname "$WALLPAPER")
        WP_BASE=$(basename "$WALLPAPER")
        WP_EXT="${WP_BASE##*.}"
        WP_NAME="${WP_BASE%.*}"

        WP_DARK=""
        for candidate in \
            "$WP_DIR/${WP_NAME}-dark.$WP_EXT" \
            "$WP_DIR/${WP_NAME}_dark.$WP_EXT" \
            "$WP_DIR/dark-${WP_NAME}.$WP_EXT"; do
            if [[ -f "$candidate" ]]; then
                WP_DARK="$candidate"
                break
            fi
        done

        if [[ -n "$REAL_USER" ]] && [[ "$REAL_USER" != "root" ]]; then
            user_uid=$(id -u "$REAL_USER" 2>/dev/null)
            dbus_socket="/run/user/$user_uid/bus"

            if [[ -S "$dbus_socket" ]]; then
                sudo -u "$REAL_USER" env DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_socket" \
                    gsettings set org.gnome.desktop.background picture-uri "$WP_URI" 2>/dev/null || true
                if [[ -n "$WP_DARK" ]]; then
                    if command -v python3 >/dev/null 2>&1; then
                        WP_DARK_URI="file://$(python3 -c \
                            'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' \
                            "$WP_DARK" 2>/dev/null || echo "${WP_DARK// /%20}")"
                    else
                        WP_DARK_URI="file://${WP_DARK// /%20}"
                    fi
                    sudo -u "$REAL_USER" env DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_socket" \
                        gsettings set org.gnome.desktop.background picture-uri-dark "$WP_DARK_URI" 2>/dev/null || true
                else
                    sudo -u "$REAL_USER" env DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_socket" \
                        gsettings set org.gnome.desktop.background picture-uri-dark "$WP_URI" 2>/dev/null || true
                fi
            else
                sudo -u "$REAL_USER" gsettings set org.gnome.desktop.background picture-uri "$WP_URI" 2>/dev/null || true
                sudo -u "$REAL_USER" gsettings set org.gnome.desktop.background picture-uri-dark "$WP_URI" 2>/dev/null || true
            fi

            sleep 2
            sync 2>/dev/null || true

            CURRENT=$(sudo -u "$REAL_USER" gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || echo "?")
            echo "   ✅ Hintergrundbild gesetzt."
            echo "   ℹ️  picture-uri jetzt: $CURRENT"
        fi
    fi
fi
step_mark DONE_WALLPAPER_SET
state_save
fi

echo ""
echo "===== Ubuntu-PLUS Transformer – Fertig! ====="
echo ""
if [[ "$NO_GAMES" == "true" ]]; then
    echo "❌ Spiele-Unterstützung wurde DEAKTIVIERT (keine Gaming-Tools installiert)."
else
    echo "✅ Spiele-Unterstützung wurde AKTIVIERT (Steam, Lutris, Heroic, etc.)."
fi

case "$OFFICE_SUITE" in
    none)        echo "❌ Büro-Software wurde DEAKTIVIERT." ;;
    libreoffice) echo "✅ Büro-Software: LibreOffice wurde installiert." ;;
    onlyoffice)  echo "✅ Büro-Software: ONLYOFFICE Desktop Editors wurde installiert." ;;
    abiword)     echo "✅ Büro-Software: AbiWord (+ Gnumeric) wurde installiert." ;;
esac

BROWSER_INSTALLED=()
[[ "$INSTALL_BRAVE"   == "true" ]] && BROWSER_INSTALLED+=("Brave")
[[ "$INSTALL_VIVALDI" == "true" ]] && BROWSER_INSTALLED+=("Vivaldi")
[[ "$INSTALL_CHROME"  == "true" ]] && BROWSER_INSTALLED+=("Google Chrome")
[[ "$INSTALL_FIREFOX" == "true" ]] && BROWSER_INSTALLED+=("Firefox")

BROWSER_REMOVED=()
[[ "$REMOVE_BRAVE"   == "true" ]] && BROWSER_REMOVED+=("Brave")
[[ "$REMOVE_VIVALDI" == "true" ]] && BROWSER_REMOVED+=("Vivaldi")
[[ "$REMOVE_CHROME"  == "true" ]] && BROWSER_REMOVED+=("Google Chrome")
[[ "$REMOVE_FIREFOX" == "true" ]] && BROWSER_REMOVED+=("Firefox")

if [[ ${#BROWSER_INSTALLED[@]} -gt 0 ]]; then
    echo "✅ Browser installiert: ${BROWSER_INSTALLED[*]}"
fi
if [[ ${#BROWSER_REMOVED[@]} -gt 0 ]]; then
    echo "🗑️  Browser entfernt:    ${BROWSER_REMOVED[*]}"
fi
if [[ ${#BROWSER_INSTALLED[@]} -eq 0 && ${#BROWSER_REMOVED[@]} -eq 0 ]]; then
    echo "ℹ️  Keine Browser-Aktionen ausgeführt."
fi

if [[ -n "$WALLPAPER" ]] && [[ -f "$WALLPAPER" ]]; then
    echo "✅ Hintergrundbild gesetzt: $(basename "$WALLPAPER")"
fi

if [[ "$NO_FIREWALL" == "true" ]]; then
    echo "❌ Firewall wurde DEAKTIVIERT."
else
    echo "✅ Firewall wurde AKTIVIERT."
fi
echo ""
echo "✅ Avatare, Wallpaper und GNOME-Layout wurden für den aktuellen Benutzer gesetzt"
echo "✅ Dokumentenvorlagen und .hidden für aktuellen und neue Benutzer"
echo "✅ Desktop-Backup (alle Einstellungen, Erweiterungen, Wallpaper) wiederhergestellt"
echo "✅ Weitere Pakete und Flatpaks installiert"
echo "✅ Dock wurde aktiviert und bleibt sichtbar (autohide=false)"
echo "✅ Nautilus: 'Verknüpfung erstellen' im Kontextmenü aktiviert"
echo "✅ Nautilus: 'System' (Root) in der Seitenleiste hinzugefügt"
echo ""

# ────────────── STATE SPEICHERN ──────────────
state_save
# ─────────────────────────────────────────────

# ────────────── SELBST-DEINSTALLATION ──────────────
if dpkg -l ubuntu-plus-transformer 2>/dev/null | grep -q '^ii'; then
    echo ""
    echo ">>> Plane Selbst-Deinstallation des Transformers ..."

    if command -v systemd-run >/dev/null 2>&1; then
        if systemd-run --on-active=20 --unit=ubuntu-plus-selfremove-now --collect \
                /bin/bash -c 'DEBIAN_FRONTEND=noninteractive apt-get remove -y ubuntu-plus-transformer' \
                >/dev/null 2>&1; then
            echo "   ✅ Sofort-Entfernung geplant (in 20 Sekunden)."
        fi
    fi

    cat > /etc/systemd/system/ubuntu-plus-selfremove.service << 'SELFREMOVEEOF'
[Unit]
Description=Ubuntu-PLUS Transformer Self-Removal
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'sleep 30; DEBIAN_FRONTEND=noninteractive apt-get remove -y ubuntu-plus-transformer; systemctl disable ubuntu-plus-selfremove.service 2>/dev/null; rm -f /etc/systemd/system/ubuntu-plus-selfremove.service; systemctl daemon-reload'
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
SELFREMOVEEOF
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable ubuntu-plus-selfremove.service 2>/dev/null || true

    echo "   ✅ Boot-Time-Entfernung aktiviert (Sicherheitsnetz)."
    echo "      (Deine Wallpaper, Icons und Einstellungen bleiben erhalten.)"
fi
# ───────────────────────────────────────────────────

echo ""
echo "=== Ende: $(date) ==="
echo "=== Log gespeichert unter: $LOG_FILE ==="

if [[ "$REBOOT" == "true" ]]; then
    echo ">>> System wird in 5 Sekunden neu gestartet ..."
    sleep 5
    reboot
else
    echo "Ein Neustart wird empfohlen, um alle Änderungen zu übernehmen."
fi

exit 0
