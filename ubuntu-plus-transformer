    cleanup_early
    rm -rf "$WORKDIR" 2>/dev/null || true
}
trap cleanup_full EXIT

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo $USER)}"

# =========================================================
# STATE-DATEI LADEN UND MIT ARGUMENTEN VERGLEICHEN
# =========================================================
if [[ "$RESET_STATE" == "true" ]]; then
    if [[ -f "$STATE_FILE" ]]; then
        rm -f "$STATE_FILE"
        echo ">>> --reset: State-Datei gelöscht: $STATE_FILE"
    else
        echo ">>> --reset: Keine State-Datei vorhanden."
    fi
    exit 0
fi

if [[ "$FORCE_RERUN" == "true" ]]; then
    if [[ -f "$STATE_FILE" ]]; then
        rm -f "$STATE_FILE"
        echo ">>> --force: State-Datei gelöscht, alles wird neu durchlaufen."
    fi
fi

state_load

# Nutzerentscheidungen aus State anwenden, wo kein Argument übergeben wurde
if [[ -z "$_ARG_SET_OFFICE" ]] && [[ -n "$STATE_OFFICE_SUITE" ]]; then
    OFFICE_SUITE="$STATE_OFFICE_SUITE"
    echo "   ℹ️  OFFICE_SUITE aus State: $OFFICE_SUITE"
fi
if [[ -z "$_ARG_SET_DEFAULT_ICON" ]] && [[ -n "$STATE_DEFAULT_ICON" ]]; then
    DEFAULT_ICON="$STATE_DEFAULT_ICON"
    echo "   ℹ️  DEFAULT_ICON aus State: $DEFAULT_ICON"
fi
if [[ -z "$_ARG_SET_WALLPAPER" ]] && [[ -n "$STATE_WALLPAPER" ]]; then
    WALLPAPER="$STATE_WALLPAPER"
    echo "   ℹ️  WALLPAPER aus State: $WALLPAPER"
fi
if [[ -z "$_ARG_SET_NO_GAMES" ]] && [[ -n "$STATE_NO_GAMES" ]]; then
    NO_GAMES="$STATE_NO_GAMES"
    echo "   ℹ️  NO_GAMES aus State: $NO_GAMES"
fi
if [[ -z "$_ARG_SET_NO_FIREWALL" ]] && [[ -n "$STATE_NO_FIREWALL" ]]; then
    NO_FIREWALL="$STATE_NO_FIREWALL"
    echo "   ℹ️  NO_FIREWALL aus State: $NO_FIREWALL"
fi

# Icon-Themes aus State
if [[ "$STATE_INSTALL_WHITESUR" == "true" ]]; then INSTALL_WHITESUR=true; fi
if [[ "$STATE_INSTALL_MINTY" == "true" ]]; then INSTALL_MINTY=true; fi
if [[ "$STATE_INSTALL_WE10X" == "true" ]]; then INSTALL_WE10X=true; fi
if [[ "$STATE_INSTALL_BREEZE" == "true" ]]; then INSTALL_BREEZE=true; fi
if [[ "$STATE_INSTALL_ZORIN" == "true" ]]; then INSTALL_ZORIN=true; fi
if [[ "$STATE_INSTALL_MOKA" == "true" ]]; then INSTALL_MOKA=true; fi
if [[ "$STATE_INSTALL_NUMIX" == "true" ]]; then INSTALL_NUMIX=true; fi
if [[ "$STATE_INSTALL_POP" == "true" ]]; then INSTALL_POP=true; fi
if [[ "$STATE_INSTALL_PAPIRUS" == "true" ]]; then INSTALL_PAPIRUS=true; fi

# Browser aus State
if [[ "$STATE_INSTALL_BRAVE" == "true" ]]; then INSTALL_BRAVE=true; fi
if [[ "$STATE_INSTALL_VIVALDI" == "true" ]]; then INSTALL_VIVALDI=true; fi
if [[ "$STATE_INSTALL_CHROME" == "true" ]]; then INSTALL_CHROME=true; fi
if [[ "$STATE_INSTALL_FIREFOX" == "true" ]]; then INSTALL_FIREFOX=true; fi
