        --wallpaper=*) WALLPAPER="${1#*=}"; _ARG_SET_WALLPAPER="1" ;;
        --install-steam) INSTALL_STEAM=true ;;
        --install-lutris) INSTALL_LUTRIS=true ;;
        --install-heroic) INSTALL_HEROIC=true ;;
        --install-protonup) INSTALL_PROTONUP=true ;;
        --install-protontricks) INSTALL_PROTONTRICKS=true ;;
        --install-faugus) INSTALL_FAUGUS=true ;;
        --install-mangohud) INSTALL_MANGOHUD=true ;;
