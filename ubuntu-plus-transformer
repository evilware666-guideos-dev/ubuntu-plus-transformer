    if flatpak uninstall -y "$app_id" 2>/dev/null; then
        if flatpak list --app 2>/dev/null | grep -q "$app_id"; then
            echo "   ⚠️  $name ist noch in der Flatpak-Liste – versuche --delete-data ..."
