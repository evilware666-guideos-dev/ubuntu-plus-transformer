                if [[ -f "$WALL_DIR/path-dark.txt" ]]; then
                    WALL_PATH=$(cat "$WALL_DIR/path-dark.txt")
                    WALL_FILE=$(basename "$WALL_PATH")
                    if [[ -f "$WALL_DIR/$WALL_FILE" ]]; then
                        cp "$WALL_DIR/$WALL_FILE" "$BILDER_DIR/"
                    fi
                fi
            fi

            DCONF_FILE="$BACKUP_CONTENT/gnome-settings.dconf"
            if [[ -f "$DCONF_FILE" ]]; then
                CURRENT_ICON=$(sudo -u "$REAL_USER" gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'" || echo "")
