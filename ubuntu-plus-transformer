# LIVE-SYSTEM-ERKENNUNG
# =========================================================
_is_live=false
_live_reason=""

if grep -qE '(^| )(boot=casper|boot=live)( |$)' /proc/cmdline 2>/dev/null; then
    _is_live=true
    _live_reason="Kernel-Cmdline enthält boot=casper oder boot=live"
fi

if [[ -d /run/casper ]] || [[ -d /rofs ]] || [[ -d /cow ]]; then
    _is_live=true
    _live_reason="Casper/Overlay-Verzeichnisse gefunden (/run/casper, /rofs oder /cow)"
fi

_root_fs="$(findmnt -n -o FSTYPE / 2>/dev/null || true)"
if [[ "$_root_fs" == "overlay" ]] || [[ "$_root_fs" == "squashfs" ]]; then
    _is_live=true
    _live_reason="Root-Dateisystem ist $_root_fs (typisch für Live-Systeme)"
fi

if [[ "$_is_live" == "true" ]]; then
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo "❌  ABBRUCH: Live-System erkannt"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "   Grund: $_live_reason"
    echo ""
    echo "   Der Ubuntu-PLUS Transformer installiert sehr viele Pakete"
    echo "   (mehrere hundert MB). In einer Live-Session liegt das"
    echo "   Root-Dateisystem vollständig im RAM – das führt zu"
    echo "   Speichermangel und bricht mittendrin ab."
    echo ""
    echo "   ℹ️  Bitte installiere Ubuntu zuerst auf die Festplatte"
    echo "      und führe den Transformer dann im installierten"
    echo "      System aus."
    echo ""
    echo "════════════════════════════════════════════════════════════"
    exit 1
fi
