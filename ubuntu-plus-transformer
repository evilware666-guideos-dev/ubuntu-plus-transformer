# ---------------------------------------------
# Funktion: dconf-Einstellungen zuverlässig laden
# ---------------------------------------------
load_dconf_profile() {
    local dconf_file="$1"
    local user="$2"

    if [[ ! -f "$dconf_file" ]]; then
        echo "❌ dconf-Datei nicht gefunden: $dconf_file"
        return 1
    fi

    local user_uid
    user_uid=$(id -u "$user" 2>/dev/null || echo "")
    if [[ -z "$user_uid" ]]; then
        echo "❌ Benutzer $user existiert nicht."
        return 1
    fi

    local dbus_socket="/run/user/$user_uid/bus"

    if [[ -S "$dbus_socket" ]]; then
        echo "   Lade Einstellungen in die aktuelle GNOME-Sitzung ..."
        if sudo -u "$user" env DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_socket" \
                dconf load / < "$dconf_file" 2>/dev/null; then
            echo "   ✅ Einstellungen erfolgreich übernommen."
        else
            echo "   ⚠️ Teilweise Fehler beim Laden (ignoriert)."
        fi
    else
        echo "   ⚠️ Keine aktive GNOME-Sitzung (DBus-Socket nicht gefunden)."
        echo "   → Die Einstellungen werden für den nächsten Login vorbereitet."
        local user_home
        user_home=$(eval echo "~$user")
        if [[ -d "$user_home" ]]; then
            cp "$dconf_file" "$user_home/gnome-settings.dconf"
            chown "$user:$user" "$user_home/gnome-settings.dconf" 2>/dev/null || true
            echo "   → Datei nach ~/gnome-settings.dconf kopiert (wird beim Login geladen)."
        fi
    fi
}
# ---------------------------------------------

# ---------------------------------------------
# Funktion: Icon-Cache aktualisieren
# ---------------------------------------------
refresh_icon_cache() {
    local theme_name="$1"
    if [[ -z "$theme_name" ]]; then
        return 0
    fi
    if [[ -d "/usr/share/icons/$theme_name" ]]; then
        gtk-update-icon-cache -f -t "/usr/share/icons/$theme_name" 2>/dev/null || true
    fi
}
