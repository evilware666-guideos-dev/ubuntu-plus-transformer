    echo ">>> Browser: $name wird deinstalliert ..."

    if ! command -v flatpak >/dev/null 2>&1; then
        echo "   ⚠️  Flatpak ist nicht verfügbar – $name kann nicht deinstalliert werden."
        return 1
    fi

    if ! flatpak list --app 2>/dev/null | grep -q "$app_id"; then
        echo "   ℹ️  $name ($app_id) ist nicht installiert – nichts zu tun."
        return 0
