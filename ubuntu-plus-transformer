}
# =========================================================

if [[ $EUID -ne 0 ]]; then
    echo "❌ Dieses Skript muss als root ausgeführt werden (sudo)."
    exit 1
fi

WORKDIR="/tmp/ubuntu-plus-transformer-$$"
mkdir -p "$WORKDIR"
cd "$WORKDIR"

