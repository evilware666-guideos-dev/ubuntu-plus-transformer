if [[ "$STATE_REMOVE_VIVALDI" == "true" ]]; then REMOVE_VIVALDI=true; fi
if [[ "$STATE_REMOVE_CHROME" == "true" ]]; then REMOVE_CHROME=true; fi
if [[ "$STATE_REMOVE_FIREFOX" == "true" ]]; then REMOVE_FIREFOX=true; fi

# Gaming aus State
if [[ "$STATE_INSTALL_STEAM" == "true" ]]; then INSTALL_STEAM=true; fi
if [[ "$STATE_INSTALL_LUTRIS" == "true" ]]; then INSTALL_LUTRIS=true; fi
if [[ "$STATE_INSTALL_HEROIC" == "true" ]]; then INSTALL_HEROIC=true; fi
if [[ "$STATE_INSTALL_PROTONUP" == "true" ]]; then INSTALL_PROTONUP=true; fi
if [[ "$STATE_INSTALL_PROTONTRICKS" == "true" ]]; then INSTALL_PROTONTRICKS=true; fi
if [[ "$STATE_INSTALL_FAUGUS" == "true" ]]; then INSTALL_FAUGUS=true; fi
