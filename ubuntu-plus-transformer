# =========================================================
# STATE-FILE-MECHANISMUS
# =========================================================
STATE_DIR="/var/lib/ubuntu-plus-transformer"
STATE_FILE="$STATE_DIR/state.conf"

step() {
    local key="$1"
    local desc="$2"
    if [[ "${!key}" == "1" ]]; then
        echo ">>> $desc – bereits erledigt, überspringe."
        return 1
    fi
    echo ">>> $desc ..."
    return 0
}

step_mark() {
    local key="$1"
    printf -v "$key" '%s' 1
    export "$key"
}

step_choice() {
    local key="$1"
    local desc="$2"
    local arg_set="$3"
    local current="$4"
    local saved="$5"

    if [[ "$arg_set" == "1" ]] && [[ "$current" != "$saved" ]]; then
        echo ">>> $desc – Nutzerentscheidung geändert: '$saved' → '$current'"
        return 0
    fi

    if [[ "${!key}" == "1" ]]; then
        echo ">>> $desc – bereits erledigt, überspringe."
        return 1
    fi

    echo ">>> $desc ..."
    return 0
}

state_load() {
    if [[ ! -f "$STATE_FILE" ]]; then
        return 0
    fi
    echo ">>> State-Datei gefunden – Werte werden geladen."
    # shellcheck disable=SC1090
    source "$STATE_FILE"
}

